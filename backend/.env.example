# Database (SQLite for dev; use postgresql+psycopg:// for production)
APP_DATABASE_URL=sqlite:///./app.db

# Scheduling
APP_DISPATCH_INTERVAL_SECONDS=60
APP_REMINDER_HORIZON_HOURS=168

# LLM (Phase 2 conversational agent)
DEEPSEEK_API_KEY=

# Messaging (Phase 2/4). Signature validation activates when token set.
TWILIO_AUTH_TOKEN=
